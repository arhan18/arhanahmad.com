---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';

const features = [
  'Edit everything from ONE file (src/data.ts)',
  'Light/dark mode, hero, about + stats, projects grid',
  'Experience timeline, contact section',
  'SEO meta tags ready',
  'Deploy free on Cloudflare/Vercel in 2 minutes',
  'Zero JavaScript. Perfect Lighthouse scores',
];

const price = 4.99;
---

<BaseLayout title="Astro Portfolio Template — Arhan Ahmad" description="A clean, blazing-fast developer portfolio built with Astro + Tailwind v4. Zero JavaScript. Perfect Lighthouse scores.">
  <div class="retro-grid"></div>

  <main class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Nav -->
    <nav class="flex items-center justify-between py-6 mb-8">
      <a href="/" class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white hover:text-cyan-400 transition-colors">
        ARHAN<span class="text-cyan-400">.</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/products" class="back-link">← Products</a>
        <ThemeToggle />
      </div>
    </nav>

    <!-- Product Header -->
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <span class="px-2 py-1 text-xs font-mono bg-cyan-400/10 text-cyan-400 rounded">TEMPLATE</span>
        <span class="px-2 py-1 text-xs font-mono bg-green-400/10 text-green-400 rounded">v1.0</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
        Astro Portfolio Template
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl">
        A clean, blazing-fast developer portfolio built with Astro + Tailwind v4. Zero JavaScript. Perfect Lighthouse scores out of the box.
      </p>
    </section>

    <!-- Preview -->
    <section class="mb-12">
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 overflow-hidden bg-white dark:bg-neutral-900">
        <div class="px-4 py-3 border-b border-neutral-200 dark:border-neutral-800 flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-2 text-xs text-neutral-500 font-mono">astro-portfolio-demo.pages.dev</span>
        </div>
        <iframe 
          src="https://astro-portfolio-demo.pages.dev" 
          class="w-full h-[500px] border-0"
          loading="lazy"
          title="Astro Portfolio Template Preview"
        ></iframe>
      </div>
      <p class="text-center text-sm text-neutral-500 mt-3">
        <a href="https://astro-portfolio-demo.pages.dev" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">
          Open live demo in new tab ↗
        </a>
      </p>
    </section>

    <!-- Features -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6">What's Included</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {features.map((feature) => (
          <div class="flex items-start gap-3 p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50">
            <span class="text-cyan-400 mt-0.5">✓</span>
            <span class="text-sm text-neutral-700 dark:text-neutral-300">{feature}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6">Tech Stack</h2>
      <div class="flex flex-wrap gap-3">
        <span class="px-3 py-1.5 text-sm bg-orange-400/10 text-orange-400 rounded-full border border-orange-400/20">Astro</span>
        <span class="px-3 py-1.5 text-sm bg-blue-400/10 text-blue-400 rounded-full border border-blue-400/20">Tailwind CSS v4</span>
        <span class="px-3 py-1.5 text-sm bg-yellow-400/10 text-yellow-400 rounded-full border border-yellow-400/20">TypeScript</span>
        <span class="px-3 py-1.5 text-sm bg-green-400/10 text-green-400 rounded-full border border-green-400/20">Cloudflare Pages</span>
      </div>
    </section>

    <!-- Purchase -->
    <section class="mb-12">
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h3 class="text-xl font-bold">Astro Portfolio Template</h3>
            <p class="text-sm text-neutral-500">Full source code + README + free updates to v1.x</p>
          </div>
          <div class="text-right">
            <div class="text-3xl font-extrabold text-cyan-400">${price}</div>
            <div class="text-xs text-neutral-500">one-time</div>
          </div>
        </div>

        <div class="mb-6 p-4 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700">
          <p class="text-sm text-neutral-600 dark:text-neutral-400">
            <strong>License:</strong> Personal + commercial use. No reselling the template itself.
          </p>
        </div>

        <!-- Email Input -->
        <div id="buy-section">
          <label for="email" class="block text-sm font-medium mb-2">Your email (for delivery)</label>
          <div class="flex gap-3">
            <input 
              type="email" 
              id="email" 
              placeholder="you@example.com" 
              class="flex-1 px-4 py-3 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-transparent"
              required
            />
            <button 
              id="buy-btn"
              class="px-6 py-3 bg-cyan-400 hover:bg-cyan-500 text-black font-bold rounded-lg transition-colors"
            >
              Buy ${price}
            </button>
          </div>
          <p class="text-xs text-neutral-500 mt-2">Secure payment via DodoPayments</p>
        </div>

        <!-- Success Message -->
        <div id="success-section" class="hidden text-center py-8">
          <div class="text-4xl mb-4">🎉</div>
          <h3 class="text-xl font-bold mb-2">Payment Successful!</h3>
          <p class="text-neutral-600 dark:text-neutral-400 mb-4">Check your email for the download link.</p>
          <p class="text-sm text-neutral-500">Didn't receive it? Check spam or <a href="mailto:email@arhanahmad.com" class="text-cyan-400 hover:underline">contact me</a>.</p>
        </div>
      </div>
    </section>

    <!-- Footer note -->
    <section class="text-center text-sm text-neutral-500 mb-12">
      <p>Questions before buying? <a href="mailto:email@arhanahmad.com" class="text-cyan-400 hover:underline">Message me</a></p>
    </section>
  </main>

  <script>
    const BUY_BTN = document.getElementById('buy-btn') as HTMLButtonElement;
    const EMAIL_INPUT = document.getElementById('email') as HTMLInputElement;
    const BUY_SECTION = document.getElementById('buy-section');
    const SUCCESS_SECTION = document.getElementById('success-section');

    BUY_BTN?.addEventListener('click', async () => {
      const email = EMAIL_INPUT?.value;
      if (!email || !email.includes('@')) {
        alert('Please enter a valid email');
        return;
      }

      BUY_BTN.disabled = true;
      BUY_BTN.textContent = 'Loading...';

      try {
        // Create checkout session
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            email, 
            productId: 'astro-portfolio-template',
            productName: 'Astro Portfolio Template',
            price: 4.99
          }),
        });

        const data = await res.json();

        if (data.url) {
          // Redirect to DodoPayments checkout
          window.location.href = data.url;
        } else {
          throw new Error(data.error || 'Checkout failed');
        }
      } catch (err) {
        alert('Something went wrong. Please try again.');
        BUY_BTN.disabled = false;
        BUY_BTN.textContent = `Buy $${price}`;
      }
    });

    // Check if returning from successful payment
    const params = new URLSearchParams(window.location.search);
    if (params.get('status') === 'success') {
      if (BUY_SECTION) BUY_SECTION.classList.add('hidden');
      if (SUCCESS_SECTION) SUCCESS_SECTION.classList.remove('hidden');
    }
  </script>
</BaseLayout>

<style>
  .back-link {
    font-size: 0.875rem;
    color: rgb(156 163 175);
    transition: color 0.2s;
  }
  .back-link:hover {
    color: #22d3ee;
  }
</style>
