---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="StartupGraveyard | Tombstones for dead startups"
  description="Rest in peace. Submit your dead startup and get a memorial tombstone. Free to submit, $29 for premium custom design."
  image="/og-startupgraveyard.png"
>
  <main class="min-h-screen bg-base-200">
    <div class="mx-auto max-w-2xl px-6 py-16">
      <a href="/" class="btn btn-ghost btn-sm mb-8">← Back to all projects</a>

      <div class="text-center">
        <span class="text-6xl">💀</span>
        <h1 class="mt-4 text-4xl font-extrabold">StartupGraveyard</h1>
        <p class="mt-2 text-lg text-base-content/60">
          Tombstones for dead startups. Rest in peace.
        </p>
      </div>

      <div class="mt-12 space-y-6">
        <div class="card bg-base-100 shadow-md border-2 border-base-300">
          <div class="card-body text-center">
            <div class="text-4xl">🪦</div>
            <h3 class="text-xl font-bold mt-2">RIP</h3>
            <p class="text-lg font-semibold">MyDropShippingEmpire.com</p>
            <p class="text-sm text-base-content/60">2023 — 2024</p>
            <p class="text-sm italic text-base-content/50 mt-1">"It had potential."</p>
          </div>
        </div>

        <div class="card bg-base-100 shadow-md border-2 border-base-300">
          <div class="card-body text-center">
            <div class="text-4xl">🪦</div>
            <h3 class="text-xl font-bold mt-2">RIP</h3>
            <p class="text-lg font-semibold">CryptoBro Tracker</p>
            <p class="text-sm text-base-content/60">2024 — 2024</p>
            <p class="text-sm italic text-base-content/50 mt-1">"Rug-pulled by reality."</p>
          </div>
        </div>

        <div class="text-center mt-8">
          <p class="text-base-content/60 mb-4">Submit your own dead startup</p>
          <button class="btn btn-primary">Add a Tombstone — $0</button>
          <p class="text-xs text-base-content/40 mt-2">Free to submit. $29 for a premium custom tombstone.</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
