---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LaunchPad | Get attention before you launch"
  description="Build your audience before you launch. Waitlist + discovery + cross-promo. Free to start."
  image="/og-launchpad.png"
>
  <main class="min-h-screen bg-base-200">
    <div class="mx-auto max-w-2xl px-6 py-16">
      <a href="/" class="btn btn-ghost btn-sm mb-8">← Back to all projects</a>

      <div class="text-center">
        <span class="text-6xl">🚀</span>
        <h1 class="mt-4 text-4xl font-extrabold">LaunchPad</h1>
        <p class="mt-2 text-lg text-base-content/60">
          Get attention before you launch. Waitlist + discovery + cross-promo.
        </p>
      </div>

      <div class="mt-12 space-y-6">
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <h2 class="card-title">Create your waitlist</h2>
            <p class="text-sm text-base-content/60">Set up a pre-launch page in minutes. Collect signups. Build hype.</p>
            <div class="card-actions justify-end mt-4">
              <button class="btn btn-primary">Get Started — Free</button>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <h2 class="card-title">Discover upcoming products</h2>
            <p class="text-sm text-base-content/60">Browse what's launching soon. Follow interesting products. Be an early adopter.</p>
            <div class="card-actions justify-end mt-4">
              <button class="btn btn-outline">Browse Products</button>
            </div>
          </div>
        </div>

        <div class="text-center mt-8">
          <p class="text-sm text-base-content/40">Coming soon. Building in public.</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
