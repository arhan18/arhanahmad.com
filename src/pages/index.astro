  /* MARQUEE ANIMATIONS */
  .marquee-track {
    animation: marquee var(--duration, 40s) linear infinite;
    width: max-content;
  }
  .marquee-track.marquee-reverse {
    animation-direction: reverse;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-33.333% - 16px * 3)); }
  }
  .marquee-v-track {
    animation: marquee-v var(--duration, 20s) linear infinite;
    width: 100%;
  }
  .marquee-v-track:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-v {
    0% { transform: translateY(0); }
    100% { transform: translateY(calc(-33.333% - 12px * 3)); }
  }

  /* SCROLL REVEAL */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s cubic-bezier(0, 0, 0.2, 1) calc(var(--stagger, 0) * 0.12s),
      transform 0.7s cubic-bezier(0, 0, 0.2, 1) calc(var(--stagger, 0) * 0.12s);
  }
  .reveal.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* HOVER EFFECTS */
  .card-hover {
    transition: transform 0.3s cubic-bezier(0, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0, 0, 0.2, 1);
  }
  .card-hover:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }
  .dark .card-hover:hover {
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.04);
  }
  .skill-chip-hover { transition: all 0.2s cubic-bezier(0, 0, 0.2, 1); }
  .skill-chip-hover:hover { transform: translateY(-2px) scale(1.03); }
  .icon-button {
    transition: transform 0.2s cubic-bezier(0, 0, 0.2, 1), background-color 0.2s ease, color 0.2s ease;
  }
  .icon-button:hover { transform: translateY(-2px) scale(1.05); }
  .icon-button:active { transform: scale(0.95); }
  .icon-button-sm {
    display: inline-flex; align-items: center; justify-content: center; white-space: nowrap;
    border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; transition: all 0.15s ease;
    border: 1px solid hsl(var(--input)); background-color: hsl(var(--background)); color: hsl(var(--foreground));
    min-height: 44px; min-width: 44px; height: 44px; width: 44px;
  }
  .icon-button-sm:hover { transform: translateY(-1px) scale(1.05); background-color: hsl(var(--accent)); color: hsl(var(--accent-foreground)); }
  .bento-tile { transition: transform 0.3s cubic-bezier(0, 0, 0.2, 1); }
  .bento-tile:hover { transform: translateY(-2px); }
  .avatar-disc { transition: transform 0.3s cubic-bezier(0, 0, 0.2, 1); }
  .group:hover .avatar-disc { transform: translateY(-4px) scale(1.03); }
  .badge { transition: all 0.15s ease; }
  .experience-card:hover .badge { background-color: rgba(0, 0, 0, 0.05); }
  .dark .experience-card:hover .badge { background-color: rgba(255, 255, 255, 0.08); }
  .experience-card {
    position: relative; transition: all 0.3s cubic-bezier(0, 0, 0.2, 1);
  }
  .experience-card::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; opacity: 0; transition: opacity 0.3s ease;
    background: radial-gradient(350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.06), transparent 40%);
    pointer-events: none;
  }
  .dark .experience-card::after {
    background: radial-gradient(350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.04), transparent 40%);
  }
  .experience-card:hover::after { opacity: 1; }
  .text-shadow-bg { text-shadow: 0 1px 2px hsl(var(--background)), 0 0 12px hsl(var(--background)); }

  /* VISIT BUTTON */
  .visit-button-home {
    background: rgb(38 38 38); border: 1px solid rgb(64 64 64); color: white;
    font-family: var(--font-mono), monospace; cursor: pointer; border-radius: 99px;
    align-items: center; gap: 6px; padding: 6px 12px 6px 10px; font-size: 11px;
    transition: border-color 0.25s, background 0.25s, transform 0.25s; display: flex; position: relative;
  }
  .visit-button-home:hover { border-color: #06b6d4; transform: translateY(-1px); }
  .visit-button-home b { letter-spacing: 0; font-weight: 700; }
  .visit-button-home .hit-label { color: rgb(156 163 175); text-transform: uppercase; letter-spacing: 0.12em; font-size: 9px; }
  .visit-button-home.counted { background: rgba(6, 182, 212, 0.1); border-color: rgba(6, 182, 212, 0.3); }
  .visit-button-home.counted b { color: #67e8f9; }
  .wave { animation: wave 0.6s ease-in-out; display: inline-block; }
  @keyframes wave { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(20deg); } 60% { transform: rotate(-12deg); } }
  .plus-one {
    color: #06b6d4; pointer-events: none; font-size: 11px; font-style: normal; font-weight: 700;
    animation: floatUp 1s forwards; position: absolute; top: -6px; right: 6px;
  }
  @keyframes floatUp { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-20px); } }

  /* FUN CURSOR */
  .fun-cursor { position: fixed; pointer-events: none; z-index: 9999; }
  .fun-cursor .cursor-dot {
    width: 8px; height: 8px; background: #06b6d4; border-radius: 50%;
    position: absolute; top: -4px; left: -4px; box-shadow: 0 0 10px #06b6d4;
  }
  .fun-cursor .cursor-ring {
    width: 32px; height: 32px; border: 2px solid rgba(6, 182, 212, 0.5); border-radius: 50%;
    position: absolute; top: -16px; left: -16px; transition: transform 0.1s ease;
  }
  .fun-cursor.hovering .cursor-ring { transform: scale(1.5); border-color: #a855f7; }
  .fun-cursor.hovering .cursor-dot { background: #a855f7; box-shadow: 0 0 15px #a855f7; }
</style>

<script>
  // SCROLL REVEAL
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // MOUSE GLOW
  document.querySelectorAll('.experience-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mouse-x', `${x}%`);
      card.style.setProperty('--mouse-y', `${y}%`);
    });
  });

  // VISIT COUNTER
  const COUNTER_API = 'https://visit-counter.aqeelbrh65.workers.dev';
  const DEVICE_KEY = 'arhan_device_id';
  function getDeviceId() {
    let id = localStorage.getItem(DEVICE_KEY);
    if (!id) { id = crypto.randomUUID(); localStorage.setItem(DEVICE_KEY, id); }
    return id;
  }
  async function fetchCount() {
    try {
      const res = await fetch(`${COUNTER_API}/count`);
      const data = await res.json();
      return data.count || 0;
    } catch { return 0; }
  }
  async function markVisit() {
    try {
      const deviceId = getDeviceId();
      const res = await fetch(`${COUNTER_API}/visit`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deviceId }),
      });
      const data = await res.json();
      return data;
    } catch { return { count: 0, marked: false }; }
  }
  async function updateHomeDisplay() {
    const btn = document.getElementById('homeVisitBtn');
    const countEl = document.getElementById('homeVisitCount');
    const btn2 = document.getElementById('homeVisitBtn2');
    const countEl2 = document.getElementById('homeVisitCount2');
    const count = await fetchCount();
    if (countEl) countEl.textContent = count.toString();
    if (countEl2) countEl2.textContent = count.toString();
  }
  async function handleHomeVisit() {
    const btn = document.getElementById('homeVisitBtn');
    const countEl = document.getElementById('homeVisitCount');
    const btn2 = document.getElementById('homeVisitBtn2');
    const countEl2 = document.getElementById('homeVisitCount2');
    const data = await markVisit();
    if (countEl) countEl.textContent = data.count.toString();
    if (countEl2) countEl2.textContent = data.count.toString();
    if (btn) btn.classList.add('counted');
    if (btn2) btn2.classList.add('counted');
    if (data.marked) {
      const plus = document.createElement('span');
      plus.className = 'plus-one';
      plus.textContent = '+1';
      btn?.appendChild(plus);
      setTimeout(() => plus.remove(), 1000);
    }
  }
  updateHomeDisplay();
  document.getElementById('homeVisitBtn')?.addEventListener('click', handleHomeVisit);
  document.getElementById('homeVisitBtn2')?.addEventListener('click', handleHomeVisit);

  // NEWSLETTER (Own System)
  const NEWSLETTER_API = '/api';
  
  function setupNewsletter(formId, emailId, msgId, btnId) {
    const form = document.getElementById(formId);
    const email = document.getElementById(emailId) as HTMLInputElement;
    const msg = document.getElementById(msgId);
    const btn = document.getElementById(btnId) as HTMLButtonElement;
    
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailVal = email?.value;
        if (!emailVal) return;
        
        btn.disabled = true;
        btn.textContent = '...';
        
        try {
          const res = await fetch(`${NEWSLETTER_API}/subscribe`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal }),
          });
          const data = await res.json();
          
          if (msg) {
            msg.textContent = data.message || 'Thanks for subscribing!';
            msg.className = 'text-xs mt-2 text-green-500';
            msg.classList.remove('hidden');
          }
          email.value = '';
        } catch {
          if (msg) {
            msg.textContent = 'Error subscribing. Try again.';
            msg.className = 'text-xs mt-2 text-red-500';
            msg.classList.remove('hidden');
          }
        } finally {
          btn.disabled = false;
          btn.textContent = '→';
        }
      });
    }
  }
  
  setupNewsletter('newsletterForm', 'newsletterEmail', 'newsletterMsg', 'newsletterBtn');
  setupNewsletter('newsletterForm2', 'newsletterEmail2', 'newsletterMsg2', 'newsletterBtn2');

  // SUBSCRIBER COUNT
  async function loadSubscriberCount() {
    try {
      const res = await fetch('/api/subscriber-count');
      const data = await res.json();
      const el = document.getElementById('subscriberCount');
      if (el && data.count > 0) {
        el.textContent = `${data.count} founders read my newsletter`;
      }
    } catch {}
  }
  loadSubscriberCount();

  // FUN CURSOR (toggle with 'C' key)
  const funCursor = document.getElementById('funCursor');
  let cursorEnabled = localStorage.getItem('funCursor') === 'true';
  if (cursorEnabled) funCursor?.classList.remove('hidden');
  document.addEventListener('keydown', (e) => {
    if (e.key === 'c' || e.key === 'C') {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      cursorEnabled = !cursorEnabled;
      localStorage.setItem('funCursor', cursorEnabled.toString());
      funCursor?.classList.toggle('hidden');
    }
  });
  document.addEventListener('mousemove', (e) => {
    if (!cursorEnabled || !funCursor) return;
    funCursor.style.left = `${e.clientX}px`;
    funCursor.style.top = `${e.clientY}px`;
  });
  document.querySelectorAll('a, button, .experience-card, .icon-button, .icon-button-sm').forEach(el => {
    el.addEventListener('mouseenter', () => funCursor?.classList.add('hovering'));
    el.addEventListener('mouseleave', () => funCursor?.classList.remove('hovering'));
  });
</script>
