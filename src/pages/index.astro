---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SidebarAds from '../components/SidebarAds.astro';

const experiences = [
  { company: 'Building in Public', title: 'Creator', badges: ['X', 'Newsletter'], metric: 'Sharing the journey on X and newsletter.' },
  { company: 'AI Agents', title: 'Learner', badges: ['AI', 'Automation'], metric: 'Exploring how AI can build, automate, and scale.' },
  { company: 'Computer Science', title: 'Student', badges: ['CSE', '2024 — 2028'], metric: 'Learning the foundations while building the future.' },
];

const stack = [
  { name: 'Astro', slug: 'astro' },
  { name: 'Cloudflare', slug: 'cloudflare' },
  { name: 'Tailwind', slug: 'tailwindcss' },
  { name: 'JavaScript', slug: 'javascript' },
  { name: 'TypeScript', slug: 'typescript' },
  { name: 'Python', slug: 'python' },
  { name: 'Java', slug: 'openjdk' },
  { name: 'Git', slug: 'git' },
  { name: 'GitHub', slug: 'github' },
  { name: 'AI Tools', slug: null },
  { name: 'Next.js', slug: 'nextdotjs' },
  { name: 'Supabase', slug: 'supabase' },
];

const focusAreas = [
  { name: 'Building Weird Websites', body: 'One ridiculous idea at a time.' },
  { name: 'AI Agents', body: 'Exploring how AI can build and automate.' },
  { name: 'Indie Hacking', body: 'Shipping products solo, learning in public.' },
  { name: 'Newsletter', body: 'Weekly insights on building and shipping.' },
  { name: 'X (Twitter)', body: 'Sharing the journey, one tweet at a time.' },
  { name: 'Open Source', body: 'Giving back to the community.' },
];

const projects = [
  { name: 'NameAPlanet', description: 'Name a planet after someone you love.', language: 'Web', type: 'building', url: '#' },
  { name: 'BuyAMoon', description: 'Claim a fictional moon crater for someone.', language: 'Web', type: 'building', url: '#' },
  { name: 'StartupGraveyard', description: 'Tombstones for dead startups.', language: 'Web', type: 'building', url: '#' },
  { name: 'FlipAFate', description: 'Stop overthinking. Let fate decide.', language: 'Web', type: 'building', url: '#' },
  { name: 'ChaosGarden', description: 'Track your bad habits. Celebrate your failures.', language: 'Web', type: 'building', url: '#' },
  { name: 'TimeWasted', description: 'Calculate how much time you wasted on the internet.', language: 'Web', type: 'building', url: '#' },
  { name: 'LaunchPad', description: 'Get attention before you launch.', language: 'Web', type: 'building', url: '#' },
  { name: 'MakeAbsurd', description: 'AI landing pages for ridiculous products.', language: 'Web', type: 'building', url: '#' },
  { name: 'WeirdPage', description: 'Portfolio for people who build weird things.', language: 'Web', type: 'building', url: '#' },
  { name: 'Subtitly', description: 'Auto-generate subtitles for any video. AI-powered.', language: 'Web', type: 'live', url: 'https://subtitly.pages.dev' },
  { name: 'ToolboxImage', description: 'AI image toolbox. Resize, compress, convert.', language: 'Web', type: 'live', url: 'https://toolboximage.com' },
  { name: 'Sufi Khanqah', description: 'The living library of Sufism. Search sources, trace lineages.', language: 'Web', type: 'live', url: 'https://sufi-khanqah.aqeelbrh65.workers.dev' },
  { name: 'OutbidCopy', description: 'Get backlinks by outbidding competitors.', language: 'Web', type: 'building', url: '/outbid' },
];

const liveProducts = [
  { name: 'ToolboxImage', url: 'https://toolboximage.com', description: 'AI-powered image toolbox.', icon: '🧰' },
  { name: 'Subtitly', url: 'https://subtitly.pages.dev', description: 'Auto-generate subtitles for any video.', icon: '🎬' },
  { name: 'Sufi Khanqah', url: 'https://sufi-khanqah.aqeelbrh65.workers.dev', description: 'The living library of Sufism.', icon: '📚' },
];

const blogs = [
  { title: 'Why I Build Weird Websites', date: 'Sep 2026', excerpt: 'The story behind my obsession with ridiculous web products.' },
  { title: 'Vibe Coding 101', date: 'Aug 2026', excerpt: 'How to ship products using AI-assisted development.' },
];
---

<BaseLayout title="Arhan Ahmad — Builder & Indie Hacker">
  <SidebarAds />
  <!-- RETRO GRID + METEORS -->
  <div class="retro-grid"></div>
  <div class="meteor-shower">
    {Array.from({ length: 30 }).map((_, i) => (
      <span
        class="meteor"
        style={`top: ${Math.random() * 100}%; left: ${Math.random() * 100}%; animation: meteor ${2 + Math.random() * 8}s linear ${Math.random() * 2}s infinite;`}
      />
    ))}
  </div>

  <!-- FUN CURSOR -->
  <div id="funCursor" class="fun-cursor hidden">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
  </div>

  <main class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">

    <!-- SECTION 1: HERO -->
    <section class="grid grid-cols-1 gap-4 md:grid-cols-[2fr_1fr] reveal" style="--stagger: 0;">
      <!-- Left: Lets be weird + Newsletter + Social -->
      <div class="bento-tile flex flex-col justify-between p-6 md:p-8">
        <h1 class="font-display font-bold tracking-tighter text-left text-4xl leading-[1.05] sm:text-5xl md:text-6xl lg:text-7xl">
          Lets' be weird.
        </h1>
        
        <!-- Newsletter Subscribe (Own System) -->
        <div class="mt-6 p-4 rounded-lg" style="background: hsl(var(--muted)); border: 1px solid hsl(var(--border));">
          <p class="text-xs font-mono uppercase tracking-wider mb-2" style="color: hsl(var(--muted-foreground));">Subscribe to newsletter</p>
          <form id="newsletterForm" class="flex gap-2">
            <input type="email" id="newsletterEmail" placeholder="your@email.com" required class="flex-1 px-3 py-2 text-sm rounded focus:outline-none focus:border-cyan-400" style="background: hsl(var(--background)); border: 1px solid hsl(var(--border)); color: hsl(var(--foreground));" />
            <button type="submit" id="newsletterBtn" class="px-4 py-2 text-sm font-mono bg-cyan-500 hover:bg-cyan-400 text-white rounded transition-colors">→</button>
          </form>
          <p id="newsletterMsg" class="text-xs mt-2 hidden"></p>
          <p id="subscriberCount" class="text-xs font-mono mt-2" style="color: hsl(var(--muted-foreground));"></p>
        </div>

        <div class="mt-4 flex items-center gap-3">
          <a href="https://x.com/ahmadarhankhan" target="_blank" rel="noopener noreferrer" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
          </a>
          <a href="https://github.com/arhan18" target="_blank" rel="noopener noreferrer" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/arhan-ahmad-khan-539557312/" target="_blank" rel="noopener noreferrer" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="mailto:email@arhanahmad.com" class="icon-button" title="email@arhanahmad.com">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          <ThemeToggle />
        </div>
      </div>

      <!-- Right: Name + Tagline + Avatar -->
      <div class="bento-tile flex flex-col justify-between p-6 md:p-8">
        <div>
          <p class="text-3xl font-semibold md:text-3xl">Arhan Ahmad</p>
          <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">Building weird websites</p>
        </div>
        <div class="mt-4 flex items-center gap-3">
          <button id="homeVisitBtn" class="visit-button-home" title="Mark your visit">
            <span class="wave" aria-hidden="true">👋</span>
            <b id="homeVisitCount">···</b>
            <span class="hit-label">visitors</span>
          </button>
          <a href="/journal" class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-cyan-400 transition-colors font-mono uppercase tracking-wider">Journal →</a>
        </div>
        <div class="avatar-disc mt-6 self-start">
          <img src="/avatar.jpg" alt="Arhan Ahmad" class="h-full w-full object-cover" />
        </div>
        <!-- Hire Me Fiverr Button -->
        <a href="https://www.fiverr.com/arhanahmad979?public_mode=true" target="_blank" rel="noopener noreferrer" class="hire-fiverr-btn mt-4">
          <span class="fiverr-icon">⚡</span>
          <span>Hire me on Fiverr</span>
          <span class="fiverr-arrow">↗</span>
        </a>
      </div>
    </section>

    <!-- SECTION 4: PROJECTS (marquee) -->
    <section class="mt-4 reveal" style="--stagger: 3;">
      <div class="group/tile relative h-[220px] sm:h-[260px] md:h-[220px] sm:h-[260px] md:h-[304px] overflow-hidden">
        <div class="absolute inset-x-0 top-0 z-20 px-5 pt-5 pb-3 flex items-center gap-2">
          <a href="/projects" class="section-link">→</a>
          <h2 class="text-xl sm:text-xl sm:text-2xl font-semibold tracking-tight text-shadow-bg">Projects</h2>
          <span class="badge">{projects.length}</span>
        </div>
        <div class="absolute inset-0 top-14 overflow-hidden">
          <div class="marquee-track flex gap-4 p-2 h-full items-start" style="--duration: 40s;">
            {[...projects, ...projects, ...projects].map((proj, i) => (
              <a href={proj.url} target="_blank" rel="noopener noreferrer" class="experience-card flex-shrink-0 cursor-pointer card-hover" style="width: 220px;">
                <div class="flex items-center gap-2">
                  <span class={proj.type === 'live' ? 'badge-live' : 'badge-building'}>{proj.type === 'live' ? 'Live' : 'Building'}</span>
                </div>
                <div class="mt-3">
                  <p class="text-sm font-semibold">{proj.name}</p>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2">{proj.description}</p>
                </div>
                <div class="mt-3">
                  <span class="badge">{proj.language}</span>
                </div>
              </a>
            ))}
          </div>
          <div class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-background/90 via-background/50 to-transparent z-10"></div>
          <div class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-background/90 via-background/50 to-transparent z-10">          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4.5: DIGITAL PRODUCTS -->
    <section class="mt-4 reveal" style="--stagger: 4.5;">
      <div class="bento-tile p-6 md:p-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold tracking-tight">Digital Products</h2>
          <a href="/products" class="text-xs text-cyan-400 hover:underline">View all →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Live Product -->
          <a href="/astro-portfolio" class="group p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50 hover:border-cyan-400/30 transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-cyan-400">Template</span>
              <span class="text-sm font-bold text-cyan-400">$4.99</span>
            </div>
            <h3 class="font-semibold group-hover:text-cyan-400 transition-colors">Astro Portfolio</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Blazing-fast portfolio template. Zero JS.</p>
          </a>

          <!-- Upcoming Products -->
          <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50 opacity-60">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Guide</span>
              <span class="text-xs text-neutral-500">Soon</span>
            </div>
            <h3 class="font-semibold">Prompt Templates</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">50+ prompts for vibe coding.</p>
          </div>

          <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50 opacity-60">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Toolkit</span>
              <span class="text-xs text-neutral-500">Soon</span>
            </div>
            <h3 class="font-semibold">Indie Hacker Toolkit</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Curated tools for solo builders.</p>
          </div>

          <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50 opacity-60">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Playbook</span>
              <span class="text-xs text-neutral-500">Soon</span>
            </div>
            <h3 class="font-semibold">X Growth Playbook</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Grow on X as an indie hacker.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: EXPERIENCE + STACK -->
    <section class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-[1fr_2fr] reveal" style="--stagger: 4;">
      <!-- Left: Experience -->
      <div class="group/tile relative h-[220px] sm:h-[260px] md:h-[304px] overflow-hidden">
        <div class="absolute inset-x-0 top-0 z-20 px-5 pt-5 pb-3">
          <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-shadow-bg">Experience</h2>
        </div>
        <div class="absolute inset-0 top-14 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent_0%,#000_7%,#000_85%,transparent_100%)]">
          <div class="marquee-v-track flex flex-col gap-3 p-2" style="--duration: 20s;">
            {[...experiences, ...experiences, ...experiences].map(exp => (
              <div class="experience-card card-hover">
                <div class="flex items-center gap-2">
                  <div class="company-monogram">{exp.company[0]}</div>
                  <span class="text-xs font-semibold">{exp.company}</span>
                </div>
                <div class="mt-2">
                  <p class="text-sm font-semibold">{exp.title}</p>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{exp.metric}</p>
                </div>
                <div class="mt-2 flex flex-wrap gap-1">
                  {exp.badges.map(b => <span class="badge">{b}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Stack -->
      <div class="group/tile relative h-[220px] sm:h-[260px] md:h-[304px] overflow-hidden">
        <div class="absolute inset-x-0 top-0 z-20 px-5 pt-5 pb-3">
          <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-shadow-bg">Stack</h2>
        </div>
        <div class="absolute inset-0 top-14 flex items-center justify-center p-5">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-2 lg:grid-cols-3 w-full">
            {stack.map((s, i) => (
              <div class="skill-chip skill-chip-hover" style="--stagger-chip: {i};">
                {s.slug && <img src={`https://cdn.simpleicons.org/${s.slug}`} alt={s.name} class="h-4 w-4" />}
                <span>{s.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: BLOGS + FOCUS AREA -->
    <section class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 reveal" style="--stagger: 5;">
      <!-- Left: Blogs -->
      <div class="group/tile relative h-[220px] sm:h-[260px] md:h-[304px] overflow-hidden">
        <div class="absolute inset-x-0 top-0 z-20 px-5 pt-5 pb-3 flex items-center gap-2">
          <a href="/blog" class="section-link">→</a>
          <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-shadow-bg">Blogs</h2>
        </div>
        <div class="absolute inset-0 top-14 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent_0%,#000_7%,#000_85%,transparent_100%)]">
          <div class="flex flex-col gap-3 p-2 h-full">
            {blogs.map(blog => (
              <div class="experience-card cursor-pointer card-hover">
                <div class="flex items-center gap-2">
                  <span class="badge">{blog.date}</span>
                </div>
                <div class="mt-2">
                  <p class="text-sm font-semibold">{blog.title}</p>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{blog.excerpt}</p>
                </div>
              </div>
            ))}
            <div class="experience-card flex items-center justify-center">
              <p class="text-xs text-neutral-400">More coming soon...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Focus Area -->
      <div class="group/tile relative h-[220px] sm:h-[260px] md:h-[304px] overflow-hidden">
        <div class="absolute inset-x-0 top-0 z-20 px-5 pt-5 pb-3">
          <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-shadow-bg">Focus Area</h2>
        </div>
        <div class="absolute inset-0 top-14 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent_0%,#000_7%,#000_85%,transparent_100%)]">
          <div class="flex flex-wrap gap-2 p-2">
            {focusAreas.map(area => (
              <span class="hero-pill">{area.name}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 7: VISIT COUNTER + NEWSLETTER -->
    <section class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 reveal" style="--stagger: 6;">
      <!-- Visit Counter -->
      <div class="bento-tile p-6 md:p-8">
        <h3 class="text-lg font-semibold mb-4">Visitors</h3>
        <button id="homeVisitBtn2" class="visit-button-home-large" title="Mark your visit">
          <span class="wave" aria-hidden="true">👋</span>
          <b id="homeVisitCount2">···</b>
          <span class="hit-label">unique visitors</span>
        </button>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-3">Real per-device tracking. No fakes.</p>
      </div>

      <!-- Newsletter -->
      <div class="bento-tile p-6 md:p-8">
        <h3 class="text-lg font-semibold mb-4">Newsletter</h3>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-4">Weekly insights on building and shipping products.</p>
        <form id="newsletterForm2" class="flex gap-2">
          <input type="email" id="newsletterEmail2" placeholder="your@email.com" required class="flex-1 px-3 py-2 text-sm bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded focus:outline-none focus:border-cyan-400" />
          <button type="submit" id="newsletterBtn2" class="px-4 py-2 text-sm font-mono bg-cyan-500 hover:bg-cyan-400 text-white rounded transition-colors">→</button>
        </form>
        <p id="newsletterMsg2" class="text-xs mt-2 hidden"></p>
      </div>
    </section>

    <!-- LIVE PRODUCTS -->
    <section class="mt-4 reveal">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="https://toolboximage.com" target="_blank" rel="noopener noreferrer" class="group/tile bento-tile block p-6 md:p-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🧰</span>
            <h3 class="text-xl font-semibold">ToolboxImage</h3>
            <span class="text-xs font-mono text-green-400 bg-green-400/10 px-2 py-0.5 rounded">LIVE</span>
          </div>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">AI-powered image toolbox. Resize, compress, convert — all in your browser.</p>
          <span class="mt-4 inline-block text-xs font-mono text-cyan-400 group-hover:translate-x-1 transition-transform">Visit toolboximage.com →</span>
        </a>
        <a href="https://subtitly.pages.dev" target="_blank" rel="noopener noreferrer" class="group/tile bento-tile block p-6 md:p-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🎬</span>
            <h3 class="text-xl font-semibold">Subtitly</h3>
            <span class="text-xs font-mono text-green-400 bg-green-400/10 px-2 py-0.5 rounded">LIVE</span>
          </div>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">Auto-generate subtitles for any video. AI-powered transcription.</p>
          <span class="mt-4 inline-block text-xs font-mono text-cyan-400 group-hover:translate-x-1 transition-transform">Visit subtitly.pages.dev →</span>
        </a>
      </div>
    </section>

    <!-- SELL YOUR SLOT -->
    <section class="mt-4 reveal">
      <div class="sell-slot-banner">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-2xl font-bold tracking-tight">Sell Your Slot</h2>
            <p class="text-sm text-neutral-400 mt-1">Get your site listed here. Start at $1. Price increases as slots fill.</p>
          </div>
          <a href="/sell-slot" class="sell-slot-btn">
            Buy Your Slot →
          </a>
        </div>
        <div class="mt-4 flex items-center gap-4">
          <span class="text-xs font-mono text-cyan-400">Only 8 slots remaining</span>
          <span class="text-xs font-mono text-neutral-500">Starting at $1</span>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-border py-6 sm:py-8 mt-8 reveal" style="--stagger: 7;">
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 text-center sm:text-left">
          &copy; {new Date().getFullYear()} Arhan Ahmad
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
