---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const liveProjects = [
  { name: 'ToolboxImage', description: 'AI image toolbox. Resize, compress, convert.', url: 'https://toolboximage.com', launches: 'Sep 2026' },
  { name: 'Subtitly', description: 'Auto-generate subtitles for any video.', url: 'https://subtitly.pages.dev', launches: 'Sep 2026' },
];

const buildingProjects = [
  { name: 'OutbidCopy', description: 'Get backlinks by outbidding competitors.', url: '/outbid', launches: 'Sep 2026' },
  { name: 'RichestStartup', description: 'Buy a spot at the top. Featured placements, different tiers, leaderboard.', url: '#', launches: 'Coming soon' },
  { name: 'NameAPlanet', description: 'Name a planet after someone you love.', url: '#', launches: 'Coming soon' },
  { name: 'BuyAMoon', description: 'Claim a fictional moon crater for someone.', url: '#', launches: 'Coming soon' },
  { name: 'StartupGraveyard', description: 'Tombstones for dead startups.', url: '#', launches: 'Coming soon' },
  { name: 'FlipAFate', description: 'Stop overthinking. Let fate decide.', url: '#', launches: 'Coming soon' },
  { name: 'ChaosGarden', description: 'Track your bad habits. Celebrate your failures.', url: '#', launches: 'Coming soon' },
  { name: 'TimeWasted', description: 'Calculate how much time you wasted on the internet.', url: '#', launches: 'Coming soon' },
  { name: 'LaunchPad', description: 'Get attention before you launch.', url: '#', launches: 'Coming soon' },
  { name: 'MakeAbsurd', description: 'AI landing pages for ridiculous products.', url: '#', launches: 'Coming soon' },
  { name: 'WeirdPage', description: 'Portfolio for people who build weird things.', url: '#', launches: 'Coming soon' },
];
---

<BaseLayout title="Projects — Arhan Ahmad" description="All projects built by Arhan Ahmad.">
  <div class="retro-grid"></div>

  <main class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Nav -->
    <nav class="flex items-center justify-between py-6 mb-8">
      <a href="/" class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white hover:text-cyan-400 transition-colors">
        ARHAN<span class="text-cyan-400">.</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/" class="back-link">← Home</a>
        <ThemeToggle />
      </div>
    </nav>

    <!-- Hero -->
    <header class="mb-12">
      <p class="text-xs font-mono uppercase tracking-wider text-cyan-400 mb-4">{liveProjects.length + buildingProjects.length} projects total</p>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tighter mb-4">
        Projects<span class="text-cyan-400">.</span>
      </h1>
      <p class="text-neutral-500 dark:text-neutral-400 text-lg max-w-2xl">
        {liveProjects.length} live products. {buildingProjects.length} building. No fake placeholders.
      </p>
    </header>

    <!-- Building -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold tracking-tight mb-6">Building</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {buildingProjects.map(project => (
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-card">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-cyan-400 bg-cyan-400/10 px-2 py-0.5 rounded">Building</span>
              <span class="text-xs font-mono text-neutral-500">{project.launches}</span>
            </div>
            <h3 class="text-lg font-semibold hover:text-cyan-400 transition-colors">{project.name}</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">{project.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Live Products -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold tracking-tight mb-6 flex items-center gap-2">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        Live Products
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {liveProjects.map(project => (
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-card">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-green-400 bg-green-400/10 px-2 py-0.5 rounded">Live</span>
              <span class="text-xs font-mono text-neutral-500">{project.launches}</span>
            </div>
            <h3 class="text-lg font-semibold hover:text-cyan-400 transition-colors">{project.name}</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">{project.description}</p>
            <span class="mt-3 inline-block text-xs font-mono text-cyan-400">Visit →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-12">
      <div class="bento-tile p-6 md:p-8 text-center">
        <h2 class="text-2xl font-semibold tracking-tight mb-4">Want your site here?</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-4">
          Buy a slot on the homepage. Starting at $1.
        </p>
        <a href="/sell-slot" class="text-sm font-mono text-cyan-400 hover:text-cyan-300 transition-colors">
          Buy your slot →
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-neutral-200 dark:border-neutral-800 py-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <a href="/" class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white">ARHAN<span class="text-cyan-400">.</span></a>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">{liveProjects.length + buildingProjects.length} products. All real.</p>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .back-link {
    font-family: var(--font-mono), monospace; text-transform: uppercase; letter-spacing: 0.1em;
    color: rgb(156 163 175); font-size: 11px; text-decoration: none; transition: color 0.2s;
  }
  .back-link:hover { color: #67e8f9; }
  .project-card {
    padding: 20px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 0;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0, 0, 0.2, 1);
  }
  .project-card:hover {
    transform: translateY(-3px);
    border-color: rgb(6 182 212 / 0.3);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }
  .bento-tile { transition: transform 0.3s cubic-bezier(0, 0, 0.2, 1); }
  .bento-tile:hover { transform: translateY(-2px); }
</style>
