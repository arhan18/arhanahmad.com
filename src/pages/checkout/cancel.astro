---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Payment Cancelled — Arhan Ahmad" description="Your payment was cancelled.">
  <main class="min-h-screen flex items-center justify-center bg-gray-950 px-4">
    <div class="max-w-md w-full text-center space-y-6">
      <div class="w-20 h-20 mx-auto bg-yellow-500/20 rounded-full flex items-center justify-center">
        <svg class="w-10 h-10 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-white">Payment Cancelled</h1>
      <p class="text-gray-400">
        Your payment was not processed. No charges were made.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
      >
        Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
