---
import BaseLayout from '../../layouts/BaseLayout.astro';

const product = Astro.url.searchParams.get('product');
---

<BaseLayout title="Payment Successful — Arhan Ahmad" description="Your payment was successful.">
  <main class="min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-950 px-4">
    <!-- Astro Portfolio Template Success -->
    {product === 'astro-portfolio-template' && (
      <div class="max-w-md w-full text-center space-y-6">
        <div class="w-20 h-20 mx-auto bg-cyan-400/20 rounded-full flex items-center justify-center">
          <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Template Ready!</h1>
        <p class="text-gray-500 dark:text-gray-400">
          Check your email for the download link. You'll also receive a receipt.
        </p>
        <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-4 rounded-lg text-left">
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Quick Start:</p>
          <ol class="text-sm text-gray-700 dark:text-gray-300 space-y-1 list-decimal list-inside">
            <li>Download the ZIP from your email</li>
            <li>Edit <code class="text-cyan-500 dark:text-cyan-400">src/data.ts</code> with your info</li>
            <li>Run <code class="text-cyan-500 dark:text-cyan-400">npm install</code></li>
            <li>Deploy to Cloudflare/Vercel</li>
          </ol>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-500">
          Didn't receive the email? Check spam or <a href="mailto:email@arhanahmad.com" class="text-cyan-500 dark:text-cyan-400 hover:underline">contact me</a>.
        </p>
        <a
          href="/astro-portfolio"
          class="inline-block px-6 py-3 bg-cyan-500 text-black font-mono text-sm font-bold hover:bg-cyan-400 transition"
        >
          View Template Details →
        </a>
      </div>
    )}

    <!-- OutbidCopy Purchase Success -->
    {product === 'outbidcopy' && (
      <div id="outbid-success" class="max-w-md w-full text-center space-y-6">
        <div class="w-20 h-20 mx-auto bg-cyan-400/20 rounded-full flex items-center justify-center">
          <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Your Rank Is Live!</h1>
        <p class="text-sm text-gray-500 dark:text-gray-500">
          Your backlink is now active on arhanahmad.com. It will stay until someone outbids you.
        </p>
        <a
          href="/outbid"
          class="inline-block px-6 py-3 bg-cyan-500 text-black font-mono text-sm font-bold hover:bg-cyan-400 transition"
        >
          View OutbidCopy →
        </a>
      </div>
    )}

    <!-- Generic Success (fallback) -->
    {product !== 'astro-portfolio-template' && product !== 'outbidcopy' && (
      <div class="max-w-md w-full text-center space-y-6">
        <div class="w-20 h-20 mx-auto bg-green-500/20 rounded-full flex items-center justify-center">
          <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Payment Successful!</h1>
        <p class="text-gray-500 dark:text-gray-400">
          Thank you for your purchase. You'll receive a confirmation email shortly.
        </p>
        <a
          href="/"
          class="inline-block px-6 py-3 bg-cyan-500 text-white rounded-lg hover:bg-cyan-400 transition"
        >
          Back to Home
        </a>
      </div>
    )}
  </main>
</BaseLayout>
