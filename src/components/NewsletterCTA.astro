---
---

<section class="section-spacing reveal" id="newsletter">
  <div class="rounded-xl p-6 sm:p-8" style="background-color: hsl(var(--card)); border: 1px solid hsl(var(--border));">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl" style="color: hsl(var(--foreground));">
      Stay updated
    </h2>
    <p class="mt-2 text-sm leading-relaxed" style="color: hsl(var(--muted-foreground));">
      Get notified when I ship something new. No spam, unsubscribe anytime.
    </p>
    <form id="newsletterFormCTA" class="mt-5 flex gap-2">
      <input
        type="email"
        id="newsletterEmailCTA"
        placeholder="your@email.com"
        class="flex-1 rounded-lg px-4 py-2.5 text-sm outline-none transition-all focus:ring-2"
        style="background-color: hsl(var(--muted)); border: 1px solid hsl(var(--border)); color: hsl(var(--foreground));"
        required
      />
      <button
        type="submit"
        id="newsletterBtnCTA"
        class="rounded-lg px-5 py-2.5 text-sm font-medium transition-all hover:scale-105"
        style="background-color: hsl(var(--primary)); color: hsl(var(--primary-foreground));"
      >
        Subscribe
      </button>
    </form>
    <p id="newsletterMsgCTA" class="mt-3 text-xs hidden" style="color: hsl(var(--muted-foreground));"></p>
    <p class="mt-3 text-xs" style="color: hsl(var(--muted-foreground));">
      Reply "hii" to the welcome email to say hi. I actually read the replies.
    </p>
  </div>
</section>

<script is:inline>
  (function() {
    const form = document.getElementById('newsletterFormCTA');
    const email = document.getElementById('newsletterEmailCTA');
    const msg = document.getElementById('newsletterMsgCTA');
    const btn = document.getElementById('newsletterBtnCTA');
    
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailVal = email?.value;
        if (!emailVal) return;
        
        btn.disabled = true;
        btn.textContent = '...';
        
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailVal }),
          });
          const data = await res.json();
          
          if (msg) {
            msg.textContent = data.message || 'Thanks for subscribing!';
            msg.className = 'mt-3 text-xs text-green-500';
            msg.classList.remove('hidden');
          }
          email.value = '';
        } catch {
          if (msg) {
            msg.textContent = 'Error subscribing. Try again.';
            msg.className = 'mt-3 text-xs text-red-500';
            msg.classList.remove('hidden');
          }
        } finally {
          btn.disabled = false;
          btn.textContent = 'Subscribe';
        }
      });
    }
  })();
</script>
