<div class="rounded-2xl bg-base-100 p-5 shadow-sm lg:p-6">
  <h3 class="text-base font-bold">Stay updated</h3>
  <p class="mt-1.5 text-sm leading-relaxed text-base-content/60">
    Get notified when I ship something new. No spam, unsubscribe anytime.
  </p>
  <form class="mt-4 flex gap-2">
    <input
      type="email"
      placeholder="your@email.com"
      class="input input-bordered input-sm flex-1"
      required
    />
    <button type="submit" class="btn btn-primary btn-sm">
      Subscribe
    </button>
  </form>
</div>
