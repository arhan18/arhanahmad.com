---

<div class="flex items-start justify-start gap-5 lg:flex-col lg:gap-8">
  <span class="relative shrink-0">
    <img
      src="/avatar.jpg"
      alt="Arhan Ahmad"
      class="h-20 w-20 rounded-full object-cover ring-2 ring-base-300 lg:h-40 lg:w-40"
      loading="eager"
    />
  </span>

  <div class="flex-1">
    <h1 class="text-2xl font-extrabold tracking-tight lg:text-4xl">
      Arhan Ahmad
    </h1>

    <div class="mt-2 flex flex-col gap-1.5 lg:mt-3 lg:flex-row lg:gap-5">
      <span class="flex items-center gap-1.5 text-sm text-base-content/70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
          <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" />
        </svg>
        Lucknow, India
      </span>

      <span class="flex items-center gap-1.5 text-sm text-base-content/70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path d="M12 7.5a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5z" />
          <path fill-rule="evenodd" d="M1.5 4.875C1.5 3.839 2.34 3 3.375 3h17.25c1.035 0 1.875.84 1.875 1.875v9.75c0 1.036-.84 1.875-1.875 1.875H3.375A1.875 1.875 0 011.5 14.625v-9.75zM8.25 9.75a3.75 3.75 0 117.5 0 3.75 3.75 0 01-7.5 0zM18.75 9a.75.75 0 00-.75.75v.008c0 .414.336.75.75.75h.008a.75.75 0 00.75-.75V9.75a.75.75 0 00-.75-.75h-.008zM4.5 9.75A.75.75 0 015.25 9h.008a.75.75 0 01.75.75v.008a.75.75 0 01-.75.75H5.25a.75.75 0 01-.75-.75V9.75z" clip-rule="evenodd" />
          <path d="M2.25 18a.75.75 0 000 1.5c5.4 0 10.63.722 15.6 2.075 1.19.324 2.4-.558 2.4-1.82V18.75a.75.75 0 00-.75-.75H2.25z" />
        </svg>
        $0/mo
      </span>
    </div>

    <p class="mt-4 max-w-sm text-base leading-relaxed text-base-content/80 lg:mt-5 lg:text-lg">
      I build weird websites. One ridiculous idea at a time.
    </p>

    <div class="mt-5 flex gap-3 lg:mt-6">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-circle btn-sm btn-ghost"
          aria-label={social.name}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d={social.icon} />
          </svg>
        </a>
      ))}
    </div>
  </div>
</div>
