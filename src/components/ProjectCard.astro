---
interface Props {
  name: string;
  revenue: string;
  description: string;
  url: string;
  logo: string;
  tag?: string;
  locked?: boolean;
}

const { name, revenue, description, url, logo, tag, locked = false } = Astro.props;
---

{locked ? (
  <div class="group relative flex items-center gap-4 rounded-2xl bg-base-100 p-4 shadow-sm overflow-hidden select-none">
    <div class="absolute inset-0 bg-base-200/80 backdrop-blur-sm z-10 flex items-center justify-center">
      <span class="badge badge-lg badge-ghost gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
        Coming Soon
      </span>
    </div>
    <div class="h-12 w-12 rounded-xl bg-base-300 flex items-center justify-center text-2xl opacity-40">
      {logo}
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2">
        <h2 class="font-bold text-base-content/40">{name}</h2>
      </div>
      <p class="text-sm text-base-content/30 truncate">{description}</p>
    </div>
    <div class="text-right shrink-0">
      <p class="text-sm font-semibold text-base-content/30">{revenue}</p>
    </div>
  </div>
) : (
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center gap-4 rounded-2xl bg-base-100 p-4 shadow-sm transition-all hover:shadow-md"
  >
    <div class="h-12 w-12 rounded-xl bg-base-200 flex items-center justify-center text-2xl">
      {logo}
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2">
        <h2 class="font-bold group-hover:underline">{name}</h2>
        {tag && (
          <span class="badge badge-sm badge-success">{tag}</span>
        )}
      </div>
      <p class="text-sm text-base-content/60 truncate">{description}</p>
    </div>
    <div class="text-right shrink-0">
      <p class="text-sm font-semibold text-success">{revenue}</p>
    </div>
  </a>
)}
