---
const ads = [
  { name: 'ToolboxImage', url: 'https://toolboximage.com', category: 'AI Tool', status: 'Live' },
  { name: 'Subtitly', url: 'https://subtitly.pages.dev', category: 'Video Tool', status: 'Live' },
];
---

<aside class="sidebar-ads sidebar-left">
  {ads.map(ad => (
    <a href={ad.url} target="_blank" rel="noopener noreferrer" class="sidebar-ad-card">
      <span class="sidebar-ad-badge">{ad.status}</span>
      <h4 class="sidebar-ad-name">{ad.name}</h4>
      <p class="sidebar-ad-category">{ad.category}</p>
      <span class="sidebar-ad-link">Visit →</span>
    </a>
  ))}
  <a href="/sell-slot" class="sidebar-cta">
    <span class="sidebar-cta-badge">FOR SALE</span>
    <span class="sidebar-cta-title">Get a slot</span>
    <span class="sidebar-cta-price">Starting at $1</span>
  </a>
</aside>

<aside class="sidebar-ads sidebar-right">
  {ads.map(ad => (
    <a href={ad.url} target="_blank" rel="noopener noreferrer" class="sidebar-ad-card">
      <span class="sidebar-ad-badge">{ad.status}</span>
      <h4 class="sidebar-ad-name">{ad.name}</h4>
      <p class="sidebar-ad-category">{ad.category}</p>
      <span class="sidebar-ad-link">Visit →</span>
    </a>
  ))}
  <a href="/sell-slot" class="sidebar-cta">
    <span class="sidebar-cta-badge">FOR SALE</span>
    <span class="sidebar-cta-title">Get a slot</span>
    <span class="sidebar-cta-price">Starting at $1</span>
  </a>
</aside>

<style>
  .sidebar-ads {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 200px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sidebar-left {
    left: 20px;
  }
  .sidebar-right {
    right: 20px;
  }
  .sidebar-ad-card {
    display: block;
    padding: 16px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .sidebar-ad-card:hover {
    border-color: rgb(6 182 212 / 0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
  }
  .sidebar-ad-badge {
    font-family: var(--font-mono), monospace;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #10b981;
    background: rgb(16 185 129 / 0.1);
    padding: 3px 8px;
    border-radius: 3px;
    display: inline-block;
    margin-bottom: 8px;
  }
  .sidebar-ad-name {
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0 0 4px 0;
    line-height: 1.3;
  }
  .sidebar-ad-category {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    color: rgb(156 163 175);
    margin: 0 0 10px 0;
  }
  .sidebar-ad-link {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    color: #06b6d4;
    display: block;
  }
  .sidebar-cta {
    display: block;
    padding: 16px;
    border: 1px dashed rgb(156 163 175);
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
  }
  .sidebar-cta:hover {
    border-color: #06b6d4;
  }
  .sidebar-cta-badge {
    display: block;
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #f59e0b;
    margin-bottom: 6px;
  }
  .sidebar-cta-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin-bottom: 2px;
  }
  .sidebar-cta-price {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    color: rgb(156 163 175);
  }
  .sidebar-cta:hover .sidebar-cta-price {
    color: #06b6d4;
  }
  
  @media (max-width: 1024px) {
    .sidebar-ads {
      display: none;
    }
  }
  
  @media (min-width: 1025px) {
    main {
      margin-left: 240px;
      margin-right: 240px;
    }
  }
</style>
