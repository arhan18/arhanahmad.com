---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description = "I build weird websites. One ridiculous idea at a time.",
  image = "/og-default.png",
  canonical
} = Astro.props;

const url = Astro.url.href;
const canonicalUrl = canonical || url;
---

<!doctype html>
<html lang="en" data-theme="bumblebee">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Arhan Ahmad" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@ahmadarhankhan" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme color -->
    <meta name="theme-color" content="#fefce8" />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://arhanahmad.com/#person",
          "name": "Arhan Ahmad",
          "url": "https://arhanahmad.com",
          "image": "https://arhanahmad.com/avatar.jpg",
          "jobTitle": "Developer",
          "description": "I build weird websites. One ridiculous idea at a time.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Lucknow",
            "addressCountry": "IN"
          },
          "sameAs": [
            "https://x.com/ahmadarhankhan",
            "https://github.com/arhan18",
            "https://www.linkedin.com/in/arhan-ahmad-khan-539557312/"
          ],
          "knowsAbout": [
            "Web Development",
            "Astro",
            "Tailwind CSS",
            "Cloudflare",
            "Indie Hacking"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://arhanahmad.com/#website",
          "url": "https://arhanahmad.com",
          "name": "Arhan Ahmad",
          "description": "I build weird websites. One ridiculous idea at a time.",
          "publisher": {
            "@id": "https://arhanahmad.com/#person"
          }
        }
      ]
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
