---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const experiences = [
  { company: '9 Products', title: 'Builder', badges: ['Shipping', 'Indie Hacking'], metric: 'Designed and built 9 experimental internet products.' },
  { company: 'AI Agents', title: 'Learner', badges: ['AI', 'Automation'], metric: 'Exploring how AI can build, automate, and scale.' },
  { company: 'Building in Public', title: 'Creator', badges: ['X', 'Newsletter'], metric: 'Sharing the journey on X and newsletter.' },
  { company: 'Computer Science', title: 'Student', badges: ['CSE', '2024 — 2028'], metric: 'Learning the foundations while building the future.' },
];

const stack = [
  { name: 'Astro', slug: 'astro' },
  { name: 'Cloudflare', slug: 'cloudflare' },
  { name: 'Tailwind', slug: 'tailwindcss' },
  { name: 'JavaScript', slug: 'javascript' },
  { name: 'TypeScript', slug: 'typescript' },
  { name: 'Python', slug: 'python' },
  { name: 'Java', slug: 'openjdk' },
  { name: 'Git', slug: 'git' },
  { name: 'GitHub', slug: 'github' },
  { name: 'AI Tools', slug: null },
];

const focusAreas = [
  { name: 'Building Weird Websites', body: 'One ridiculous idea at a time.' },
  { name: 'AI Agents', body: 'Exploring how AI can build and automate.' },
  { name: 'Indie Hacking', body: 'Shipping products solo, learning in public.' },
  { name: 'Newsletter', body: 'Weekly insights on building and shipping.' },
  { name: 'X (Twitter)', body: 'Sharing the journey, one tweet at a time.' },
  { name: 'Open Source', body: 'Giving back to the community.' },
];

const projects = [
  { name: 'NameAPlanet', description: 'Name a planet after someone you love.', language: 'Web', type: 'build' },
  { name: 'BuyAMoon', description: 'Claim a fictional moon crater for someone.', language: 'Web', type: 'build' },
  { name: 'StartupGraveyard', description: 'Tombstones for dead startups.', language: 'Web', type: 'build' },
  { name: 'FlipAFate', description: 'Stop overthinking. Let fate decide.', language: 'Web', type: 'build' },
  { name: 'ChaosGarden', description: 'Track your bad habits. Celebrate your failures.', language: 'Web', type: 'build' },
  { name: 'TimeWasted', description: 'Calculate how much time you wasted on the internet.', language: 'Web', type: 'build' },
  { name: 'LaunchPad', description: 'Get attention before you launch.', language: 'Web', type: 'build' },
  { name: 'MakeAbsurd', description: 'AI landing pages for ridiculous products.', language: 'Web', type: 'build' },
  { name: 'WeirdPage', description: 'Portfolio for people who build weird things.', language: 'Web', type: 'build' },
];

const products = [
  { name: 'AI Workflow Guide', description: 'My complete AI coding workflow.', price: 'Free', type: 'guide' },
  { name: 'Prompt Templates', description: '50+ prompts for vibe coding.', price: '$4.99', type: 'template' },
  { name: 'Productivity PDF', description: 'How I ship 9 products solo.', price: 'Free', type: 'pdf' },
  { name: 'Indie Hacker Toolkit', description: 'Tools and resources I use daily.', price: '$9.99', type: 'toolkit' },
  { name: 'X Growth Playbook', description: 'How to grow on X from 0.', price: '$4.99', type: 'guide' },
];

const blogs = [
  { title: 'Why I Build Weird Websites', date: 'Sep 2026', excerpt: 'The story behind my obsession with ridiculous web products.' },
  { title: 'Vibe Coding 101', date: 'Aug 2026', excerpt: 'How to ship products using AI-assisted development.' },
];
---

<BaseLayout title="Arhan Ahmad — Builder & Indie Hacker">
  <!-- ═══════════════════════════════════════════════════════════
       RETRO GRID + METEORS (keeping the background you love)
       ═══════════════════════════════════════════════════════════ -->
  <div class="retro-grid"></div>
  <div class="meteor-shower">
    {Array.from({ length: 30 }).map((_, i) => (
      <span
        class="meteor"
        style={`top: ${Math.random() * 100}%; left: ${Math.random() * 100}%; animation: meteor ${2 + Math.random() * 8}s linear ${Math.random() * 2}s infinite;`}
      />
    ))}
  </div>

  <main class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 1: HERO (2-col: Lets be weird | Name + Tagline)
         ═══════════════════════════════════════════════════════════ -->
    <section class="grid grid-cols-1 gap-4 md:grid-cols-[2fr_1fr] reveal">
      <!-- Left: Lets be weird + Social -->
      <div class="bento-tile flex flex-col justify-between p-6 md:p-8">
        <h1 class="text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
          Lets' be weird.
        </h1>
        <div class="mt-8 flex items-center gap-3">
          <a href="https://x.com/ahmadarhankhan" target="_blank" rel="noopener noreferrer" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
          </a>
          <a href="https://github.com/arhan18" target="_blank" rel="noopener noreferrer" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/arhan-ahmad-khan-539557312/" target="_blank" rel="noopener noreferrer" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="mailto:email@arhanahmad.com" class="icon-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          <ThemeToggle />
        </div>
      </div>

      <!-- Right: Name + Tagline -->
      <div class="bento-tile flex flex-col justify-between p-6 md:p-8">
        <div>
          <h2 class="text-2xl font-semibold md:text-3xl">Arhan Ahmad</h2>
          <p class="mt-2 text-neutral-500 dark:text-neutral-400">Building weird websites</p>
        </div>
        <div class="avatar-disc mt-6 self-start">
          <img src="/avatar.jpg" alt="Arhan Ahmad" class="h-full w-full object-cover" />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 2: PROJECTS (horizontal scroll)
         ═══════════════════════════════════════════════════════════ -->
    <section class="mt-4 reveal">
      <div class="group relative overflow-hidden rounded-xl border border-border bg-background/50 backdrop-blur-sm">
        <div class="flex items-center gap-2 px-5 pt-4">
          <span class="text-sm font-semibold">Projects</span>
          <span class="badge">{projects.length}</span>
        </div>
        <div class="flex gap-4 overflow-x-auto px-5 py-4 scrollbar-hide" style="scrollbar-width: none;">
          {[...projects, ...projects].map((proj, i) => (
            <div class="experience-card flex-shrink-0 cursor-pointer" style="width: 220px;">
              <div class="flex items-center gap-2">
                <span class="badge-build">Building</span>
              </div>
              <div class="mt-3">
                <p class="text-sm font-semibold">{proj.name}</p>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2">{proj.description}</p>
              </div>
              <div class="mt-3">
                <span class="badge">{proj.language}</span>
              </div>
            </div>
          ))}
        </div>
        <!-- Fade edges -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-background/80 to-transparent"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-background/80 to-transparent"></div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 3: EXPERIENCE + STACK (2-col: 1fr 2fr)
         ═══════════════════════════════════════════════════════════ -->
    <section class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-[1fr_2fr] reveal">
      <!-- Left: Experience -->
      <div class="bento-tile flex flex-col p-5">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-sm font-semibold">Experience</span>
        </div>
        <div class="flex flex-col gap-3 flex-1">
          {experiences.map(exp => (
            <div class="experience-card">
              <div class="flex items-center gap-2">
                <div class="company-monogram">{exp.company[0]}</div>
                <span class="text-xs font-semibold">{exp.company}</span>
              </div>
              <div class="mt-2">
                <p class="text-sm font-semibold">{exp.title}</p>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{exp.metric}</p>
              </div>
              <div class="mt-2 flex flex-wrap gap-1">
                {exp.badges.map(b => <span class="badge">{b}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Stack (large feature card) -->
      <div class="bento-tile flex flex-col p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-sm font-semibold">Stack</span>
        </div>
        <div class="flex-1 flex flex-col justify-center">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-2 lg:grid-cols-3">
            {stack.map(s => (
              <div class="skill-chip">
                {s.slug && <img src={`https://cdn.simpleicons.org/${s.slug}`} alt={s.name} class="h-4 w-4" />}
                <span>{s.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 4: PRODUCTS (horizontal scroll)
         ═══════════════════════════════════════════════════════════ -->
    <section class="mt-4 reveal">
      <div class="group relative overflow-hidden rounded-xl border border-border bg-background/50 backdrop-blur-sm">
        <div class="flex items-center gap-2 px-5 pt-4">
          <span class="text-sm font-semibold">Products</span>
          <span class="text-xs text-neutral-500 dark:text-neutral-400">Like tools, pdfs, ai workflow guide</span>
        </div>
        <div class="flex gap-4 overflow-x-auto px-5 py-4 scrollbar-hide" style="scrollbar-width: none;">
          {[...products, ...products].map((prod, i) => (
            <div class="experience-card flex-shrink-0 cursor-pointer" style="width: 220px;">
              <div class="flex items-center justify-between">
                <span class="badge">{prod.type}</span>
                <span class="badge-price">{prod.price}</span>
              </div>
              <div class="mt-3">
                <p class="text-sm font-semibold">{prod.name}</p>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{prod.description}</p>
              </div>
            </div>
          ))}
        </div>
        <!-- Fade edges -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-background/80 to-transparent"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-background/80 to-transparent"></div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 5: BLOGS + FOCUS AREA (2-col)
         ═══════════════════════════════════════════════════════════ -->
    <section class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 reveal">
      <!-- Left: Blogs -->
      <div class="bento-tile flex flex-col p-5">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-sm font-semibold">Blogs</span>
        </div>
        <div class="flex flex-col gap-3 flex-1">
          {blogs.map(blog => (
            <div class="experience-card cursor-pointer">
              <div class="flex items-center gap-2">
                <span class="badge">{blog.date}</span>
              </div>
              <div class="mt-2">
                <p class="text-sm font-semibold">{blog.title}</p>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{blog.excerpt}</p>
              </div>
            </div>
          ))}
          <!-- Empty state -->
          <div class="experience-card flex items-center justify-center">
            <p class="text-xs text-neutral-400">More coming soon...</p>
          </div>
        </div>
      </div>

      <!-- Right: Focus Area -->
      <div class="bento-tile flex flex-col p-5">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-sm font-semibold">Focus Area</span>
        </div>
        <div class="flex flex-col gap-3 flex-1">
          {focusAreas.map(area => (
            <div class="experience-card">
              <div>
                <p class="text-sm font-semibold">{area.name}</p>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{area.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ -->
    <footer class="border-t border-border py-8 mt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          &copy; {new Date().getFullYear()} Arhan Ahmad. Built with Astro.
        </p>
        <div class="flex items-center gap-4">
          <a href="https://x.com/ahmadarhankhan" target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
          </a>
          <a href="https://github.com/arhan18" target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/arhan-ahmad-khan-539557312/" target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

  document.querySelectorAll('.reveal').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(el);
  });

  // Horizontal scroll drag
  document.querySelectorAll('.overflow-x-auto').forEach(el => {
    let isDown = false, startX, scrollLeft;
    el.addEventListener('mousedown', (e) => { isDown = true; el.style.cursor = 'grabbing'; startX = e.pageX - el.offsetLeft; scrollLeft = el.scrollLeft; });
    el.addEventListener('mouseleave', () => { isDown = false; el.style.cursor = 'grab'; });
    el.addEventListener('mouseup', () => { isDown = false; el.style.cursor = 'grab'; });
    el.addEventListener('mousemove', (e) => { if (!isDown) return; e.preventDefault(); const x = e.pageX - el.offsetLeft; el.scrollLeft = scrollLeft + (x - startX) * 1.5; });
    el.style.cursor = 'grab';
  });
</script>
