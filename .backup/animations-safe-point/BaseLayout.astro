---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description = "Builder & indie hacker making weird web products.",
  image = "/og-default.png",
  canonical
} = Astro.props;

const url = Astro.url.href;
const canonicalUrl = canonical || url;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Arhan Ahmad" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@ahmadarhankhan" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>

    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function() {
        try {
          var d = document.documentElement;
          var c = d.classList;
          c.remove('light', 'dark');
          var e = localStorage.getItem('theme');
          if ('system' === e || (!e && true)) {
            var t = '(prefers-color-scheme: dark)';
            var m = window.matchMedia(t);
            if (m.media !== t || m.matches) {
              d.style.colorScheme = 'dark';
              c.add('dark');
            } else {
              d.style.colorScheme = 'light';
              c.add('light');
            }
          } else if (e) {
            c.add(e || '');
          }
          if (e === 'light' || e === 'dark') d.style.colorScheme = e;
        } catch (e) {}
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://arhanahmad.com/#person",
          "name": "Arhan Ahmad",
          "url": "https://arhanahmad.com",
          "image": "https://arhanahmad.com/avatar.jpg",
          "jobTitle": "Builder & Indie Hacker",
          "description": "Builder & indie hacker making weird web products.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Lucknow",
            "addressCountry": "IN"
          },
          "sameAs": [
            "https://x.com/ahmadarhankhan",
            "https://github.com/arhan18",
            "https://www.linkedin.com/in/arhan-ahmad-khan-539557312/"
          ],
          "knowsAbout": [
            "Web Development",
            "Astro",
            "Tailwind CSS",
            "Cloudflare",
            "Indie Hacking",
            "AI Agents",
            "Building in Public"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://arhanahmad.com/#website",
          "url": "https://arhanahmad.com",
          "name": "Arhan Ahmad",
          "description": "Builder & indie hacker making weird web products.",
          "publisher": {
            "@id": "https://arhanahmad.com/#person"
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
