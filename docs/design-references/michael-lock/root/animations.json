{
  "keyframes": [
    {
      "name": "grid",
      "steps": [
        {
          "keyText": "0%",
          "cssText": "0% { transform: translateY(-50%); }"
        },
        {
          "keyText": "100%",
          "cssText": "100% { transform: translateY(0px); }"
        }
      ]
    },
    {
      "name": "marquee",
      "steps": [
        {
          "keyText": "0%",
          "cssText": "0% { transform: translateX(0px); }"
        },
        {
          "keyText": "100%",
          "cssText": "100% { transform: translateX(calc(-100% - var(--gap))); }"
        }
      ]
    },
    {
      "name": "marquee-vertical",
      "steps": [
        {
          "keyText": "0%",
          "cssText": "0% { transform: translateY(0px); }"
        },
        {
          "keyText": "100%",
          "cssText": "100% { transform: translateY(calc(-100% - var(--gap))); }"
        }
      ]
    },
    {
      "name": "meteor",
      "steps": [
        {
          "keyText": "0%",
          "cssText": "0% { transform: rotate(215deg) translateX(0px); opacity: 1; }"
        },
        {
          "keyText": "70%",
          "cssText": "70% { opacity: 1; }"
        },
        {
          "keyText": "100%",
          "cssText": "100% { transform: rotate(215deg) translateX(-500px); opacity: 0; }"
        }
      ]
    },
    {
      "name": "ripple",
      "steps": [
        {
          "keyText": "0%, 100%",
          "cssText": "0%, 100% { transform: translate(-50%, -50%) scale(1); }"
        },
        {
          "keyText": "50%",
          "cssText": "50% { transform: translate(-50%, -50%) scale(0.9); }"
        }
      ]
    },
    {
      "name": "slide",
      "steps": [
        {
          "keyText": "100%",
          "cssText": "100% { transform: translate(calc(-100% + 100cqw)); }"
        }
      ]
    },
    {
      "name": "spin",
      "steps": [
        {
          "keyText": "100%",
          "cssText": "100% { transform: rotate(1turn); }"
        }
      ]
    },
    {
      "name": "spin-around",
      "steps": [
        {
          "keyText": "0%",
          "cssText": "0% { transform: translateZ(0px) rotate(0deg); }"
        },
        {
          "keyText": "15%, 35%",
          "cssText": "15%, 35% { transform: translateZ(0px) rotate(90deg); }"
        },
        {
          "keyText": "65%, 85%",
          "cssText": "65%, 85% { transform: translateZ(0px) rotate(270deg); }"
        },
        {
          "keyText": "100%",
          "cssText": "100% { transform: translateZ(0px) rotate(1turn); }"
        }
      ]
    },
    {
      "name": "enter",
      "steps": [
        {
          "keyText": "0%",
          "cssText": "0% { opacity: var(--tw-enter-opacity,1); transform: translate3d(var(--tw-enter-translate-x,0),var(--tw-enter-translate-y,0),0) scale3d(var(--tw-enter-scale,1),var(--tw-enter-scale,1),var(--tw-enter-scale,1)) rotate(var(--tw-enter-rotate,0)); }"
        }
      ]
    },
    {
      "name": "exit",
      "steps": [
        {
          "keyText": "100%",
          "cssText": "100% { opacity: var(--tw-exit-opacity,1); transform: translate3d(var(--tw-exit-translate-x,0),var(--tw-exit-translate-y,0),0) scale3d(var(--tw-exit-scale,1),var(--tw-exit-scale,1),var(--tw-exit-scale,1)) rotate(var(--tw-exit-rotate,0)); }"
        }
      ]
    }
  ],
